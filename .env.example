# Postgres (docker compose)
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payment_service
POSTGRES_PORT=5433

# Локальный dev: infra в compose, api/consumer на хосте (localhost)
DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5433/payment_service
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Полный docker compose: DATABASE_URL и RABBITMQ_URL задаются в docker-compose.yml
# (хосты postgres и rabbitmq внутри сети compose)

API_KEY=dev-api-key
OUTBOX_POLL_INTERVAL_SECONDS=1.0
API_PORT=8000

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
